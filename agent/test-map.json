{
  "schema": "autobuilder.test_map.v1",
  "note": "Generated by onboard-repo.sh from tests/ filenames matching ac<N>_*.rs / ac0N_*.rs (the ac-judge 0.2.1 naming convention). Empty ac_test_map means no such files were found at onboarding time, not that the crate has no tests.",
  "routes": [
    {
      "glob": "src/**",
      "required_proof": [
        "cargo test --workspace"
      ]
    },
    {
      "glob": "Cargo.toml",
      "required_proof": [
        "cargo check --workspace"
      ]
    }
  ],
  "ac_test_map": {
    "AC10": "tests/placement_ac10_doctor_fix_dry_run.rs",
    "AC1": "tests/placement_ac1_should_run_gating.rs",
    "AC2": "tests/placement_ac2_assignments_json.rs",
    "AC3": "tests/placement_ac3_doctor_misplaced_enabled.rs",
    "AC4": "tests/placement_ac4_doctor_assigned_but_disabled.rs",
    "AC5": "tests/placement_ac5_doctor_healthy.rs",
    "AC7": "tests/placement_ac7_missing_placement.rs",
    "AC8": "tests/placement_ac8_may_be_off_annotation.rs",
    "AC9": "tests/placement_ac9_duplicate_key_exit2.rs"
  }
}
